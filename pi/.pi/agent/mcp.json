{
  "mcpServers": {
    "cloudflare-api": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.38",
        "https://mcp.cloudflare.com/mcp",
        "--static-oauth-client-metadata",
        "{\"scope\":\"user:read account:read offline_access\"}",
        "--auth-timeout",
        "120"
      ]
    },
    "grafana": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "command": "/Users/augusto.pinheiro/.pi/agent/bin/grafana-mcp",
      "args": []
    },
    "chrome-devtools": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "greptile": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "url": "https://api.greptile.com/mcp",
      "headers": {
        "Authorization": "${GREPTILE_MCP_AUTHORIZATION}"
      }
    },
    "node_repl": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "command": "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl",
      "args": [],
      "env": {
        "NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS": "1000",
        "NODE_REPL_NODE_MODULE_DIRS": "/Applications/ChatGPT.app/Contents/Resources/cua_node/lib/node_modules",
        "NODE_REPL_NODE_PATH": "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node",
        "NODE_REPL_TRUSTED_CODE_PATHS": "/Users/augusto.pinheiro/.codex",
        "CODEX_HOME": "/Users/augusto.pinheiro/.codex",
        "NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S": "0b03c76c1d0f3d4c81f89f58ff210ae6709fd1204d2c5a4fdffa0a7bdb961b96,6d25aa7656feac858f3a3bdaea5bcbab0dbfd426c9de8e6931ce90c399ee8e4f",
        "BROWSER_USE_AVAILABLE_BACKENDS": "chrome,iab",
        "NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER": "Control the in-app browser in conjunction with the Browser Plugin.",
        "NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME": "Control the Chrome browser in conjunction with the Chrome Plugin.",
        "BROWSER_USE_CODEX_APP_BUILD_FLAVOR": "prod",
        "BROWSER_USE_CODEX_APP_VERSION": "26.715.61943",
        "CODEX_CLI_PATH": "/Applications/ChatGPT.app/Contents/Resources/codex"
      }
    },
    "linear": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.38",
        "https://mcp.linear.app/mcp",
        "--auth-timeout",
        "120"
      ]
    },
    "firefall": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "url": "http://127.0.0.1:7767/mcp"
    },
    "vex": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "url": "http://127.0.0.1:3849/mcp"
    },
    "sauron-staging": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "url": "https://sauron.botpress.dev/pat/palantir/mcp",
      "headers": {
        "Authorization": "${SAURON_STAGING_MCP_AUTHORIZATION}"
      }
    },
    "sauron-prod": {
      "enabled": true,
      "exposure": "deferred",
      "timeout": 120,
      "url": "https://sauron.botpress.cloud/pat/mcp",
      "headers": {
        "Authorization": "${SAURON_PROD_MCP_AUTHORIZATION}"
      }
    }
  }
}
